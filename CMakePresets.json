{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-ninja",
      "displayName": "Windows x64 (Ninja, MSVC)",
      "description": "Run from an 'x64 Native Tools Command Prompt for VS' - otherwise cl.exe won't be found",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "windows-ninja-debug",
      "displayName": "Windows x64 Debug (Ninja, MSVC)",
      "inherits": "windows-ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-mingw",
      "displayName": "Windows x64 (Ninja, MinGW bundled with Qt)",
      "description": "Compiler and CMAKE_PREFIX_PATH are set in CMakeUserPresets.json (MinGW/Qt paths differ per machine)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-mingw-debug",
      "displayName": "Windows x64 Debug (Ninja, MinGW bundled with Qt)",
      "inherits": "windows-mingw",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-ninja", "configurePreset": "windows-ninja" },
    { "name": "windows-ninja-debug", "configurePreset": "windows-ninja-debug" },
    { "name": "windows-mingw", "configurePreset": "windows-mingw" },
    { "name": "windows-mingw-debug", "configurePreset": "windows-mingw-debug" }
  ],
  "testPresets": [
    { "name": "windows-ninja", "configurePreset": "windows-ninja", "output": { "outputOnFailure": true } },
    { "name": "windows-mingw", "configurePreset": "windows-mingw", "output": { "outputOnFailure": true } }
  ]
}
